{
  "name": "hyrule-warriors-helper",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:ghpages": "ng build --output-path dist/v2 --base-href /HyruleWarriorsHelper/v2/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate:character-rewards": "tsx scripts/generation/write-character-rewards.ts",
    "generate:tile-ids": "tsx scripts/generation/write-map-tile-ids.ts",
    "validate:data": "tsx scripts/validation/validate-data.ts",
    "spellcheck": "cspell \"src/**/*.{ts,html,scss}\" --no-progress",
    "generate:map-overviews": "tsx scripts/generation/write-map-overviews.ts"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@types/node": "^26.5.1",
    "cspell": "^10.3.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
